# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public catalog scope
NEXT_PUBLIC_DEFAULT_MARKETPLACE_TENANT_ID=

# Marketplace PDP cache (server-only; optional — omit to use DB-only PDP reads)
REDIS_URL=

# Site URL (metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry — server (Node/Edge); omit to disable SDK init
SENTRY_DSN=
# Sentry — browser; omit to disable client SDK
NEXT_PUBLIC_SENTRY_DSN=

# Optional sampling (defaults 0.05)
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional Sentry environment label
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Source map upload (build); when unset, uploads are disabled in next.config.js
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
